# Every variable the app reads. Add them in Vercel > Project > Settings > Environment Variables.

# --- Required ---

# Postgres connection string. Added automatically when you connect a Neon database in Vercel > Storage.
# The app also accepts POSTGRES_URL, or the Neon integration's prefixed names (hustlerslabs_members_DATABASE_URL / _POSTGRES_URL).
DATABASE_URL=

# Required. 32+ random characters. Encrypts two-step login secrets and signs admin email codes. Never change it after setup.
AUTH_SECRET=

# --- Optional ---

# Optional. One-time token for /setup (creating the first admin account). Remove it after setup if you like.
ADMIN_SETUP_TOKEN=

# Optional, but needed for any email. The Gmail address that sends email (confirm links, password resets, alerts, admin sign-in codes).
SMTP_USER=
# Optional, but needed for any email. A Google app password for SMTP_USER (16 characters, no spaces), not the normal Gmail password.
SMTP_PASS=
# Optional. Defaults to Gmail: smtp.gmail.com, port 465, secure true.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Optional. Sender shown on emails. Defaults to "Hustlers Labs <SMTP_USER>".
MAIL_FROM=
# Optional. Base address used in email links and the X callback. Defaults to https://www.hustlerslabs.com.
APP_URL=

# Optional. Connect X for creators. Without both, the Connect X panel is hidden.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional, tests only. Point X login and the X API at a mock server.
X_AUTH_BASE=
X_API_BASE=

# Optional, tests only. Points the breached-password check at a mock server. Defaults to https://api.pwnedpasswords.com.
PWNED_API_BASE=
